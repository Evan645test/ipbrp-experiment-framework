{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "data:extract": "python3 scripts/extract_phase_a.py",
    "data:apply-overrides": "python3 scripts/apply_review_overrides.py --overrides content/full-translation-overrides.json",
    "data:link-exhibits": "python3 scripts/link_exhibits.py",
    "data:references": "python3 scripts/build_references.py",
    "data:resolve-reference-dois": "python3 scripts/resolve_reference_dois.py",
    "data:fetch-reference-abstracts": "python3 scripts/build_references.py --fetch-abstracts",
    "data:fetch-publisher-abstracts": "python3 scripts/fetch_publisher_abstracts.py",
    "data:fetch-browser-abstract": "node scripts/fetch_reference_abstract_with_chrome.mjs",
    "data:fetch-database-abstracts": "python3 scripts/fetch_database_abstracts.py",
    "data:fetch-semantic-scholar-abstracts": "python3 scripts/fetch_semantic_scholar_abstracts.py",
    "data:fetch-europe-pmc-abstracts": "python3 scripts/fetch_europe_pmc_abstracts.py",
    "data:fetch-eric-abstracts": "python3 scripts/fetch_eric_abstracts.py",
    "data:fetch-openaire-abstracts": "python3 scripts/fetch_openaire_abstracts.py",
    "data:fetch-doaj-abstracts": "python3 scripts/fetch_doaj_abstracts.py",
    "data:fetch-ebsco-abstracts": "python3 scripts/fetch_ebsco_abstracts.py",
    "data:fetch-curated-abstracts": "python3 scripts/fetch_curated_reference_abstracts.py",
    "data:translate-reference-abstracts": "node scripts/translate_reference_abstracts.mjs",
    "data:summarize-reference-abstracts": "node scripts/summarize_reference_abstracts.mjs",
    "data:validate": "python3 scripts/validate_phase_a.py",
    "data:repair-paper01-order": "python3 scripts/repair_paper01_order.py --apply",
    "data:render-paper01-review": "python3 scripts/render_paper01_review.py",
    "data:repair-paper01-spots": "python3 scripts/repair_paper01_spots.py",
    "data:repair-paper01-interruptions": "python3 scripts/repair_paper01_interruptions.py",
    "data:repair-paper01-tables": "python3 scripts/repair_paper01_tables.py",
    "data:build-paper01-companion": "python3 scripts/build_paper01_companion.py",
    "data:repair-paper01-reading-quality": "python3 scripts/repair_paper01_reading_quality.py",
    "data:audit-reading-quality": "python3 scripts/audit_reading_quality.py",
    "data:prepare-remaining-companions": "python3 scripts/build_remaining_companions.py --prepare",
    "data:refine-remaining-companions": "python3 scripts/refine_remaining_companions.py",
    "data:translate-remaining-companions": "node scripts/translate_remaining_companions.mjs",
    "data:apply-remaining-companions": "python3 scripts/build_remaining_companions.py --apply",
    "test:remaining-companions": "python3 scripts/test_remaining_companions.py && node scripts/test_remaining_companions.mjs",
    "test:browser-remaining-companions": "node scripts/browser_remaining_companions.mjs",
    "test:reading-quality": "python3 scripts/test_reading_quality.py && node scripts/test_reading_quality.mjs",
    "test:paper01-companion": "node scripts/test_companion_state.mjs && python3 scripts/test_paper01_companion.py",
    "test:browser-companion": "node scripts/browser_companion.mjs",
    "test:paper01-tables": "python3 scripts/test_paper01_tables.py && node scripts/test_curator_order.mjs",
    "test:paper01-interruptions": "python3 scripts/test_paper01_interruptions.py && node scripts/test_curator_order.mjs && node scripts/test_exhibit_window.mjs",
    "test:paper01-spots": "python3 scripts/test_paper01_spots.py && node scripts/test_curator_order.mjs",
    "test:paper01-order": "python3 scripts/test_paper01_order.py && node scripts/test_curator_order.mjs",
    "data:cleanup-reading-units": "python3 scripts/cleanup_reading_units.py --apply && python3 scripts/assess_paragraph_completeness.py --apply",
    "test:reading-cleanup": "python3 scripts/test_reading_cleanup.py",
    "data:assess-paragraphs": "python3 scripts/assess_paragraph_completeness.py --apply",
    "test:paragraph-completeness": "python3 scripts/test_paragraph_completeness.py",
    "data:audit-reference-abstracts": "python3 scripts/audit_reference_abstracts.py",
    "data:complete-reference-abstracts": "node scripts/complete_reference_abstracts.mjs",
    "data:publication-gate": "python3 scripts/validate_phase_a.py --publication-gate",
    "data:translate": "node scripts/translate_with_chrome_ai.mjs",
    "test:browser": "READER_LEGACY_EXHIBITS=1 node scripts/browser_smoke.mjs && node scripts/browser_companion.mjs",
    "test:references": "python3 scripts/test_references.py",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern vendor --ignore-pattern public/pdfjs",
    "db:generate": "drizzle-kit generate",
    "test:browser-unified-entry": "node scripts/browser_unified_entry.mjs",
    "build:static": "node node_modules/vite/bin/vite.js build --config vite.static.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "opencc-js": "^1.0.5",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
